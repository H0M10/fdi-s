{
  "name": "fdi-estudio",
  "private": true,
  "version": "1.0.0",
  "description": "App de estudio para el examen de Fundamentos de IA: temas explicados, banco de preguntas y simulacro con el formato del examen.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validar": "vitest run --reporter=verbose",
    "build:unico": "npm run build && node scripts/un-solo-archivo.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
